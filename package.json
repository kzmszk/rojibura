{
	"name": "rojibura",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=26.8"
	},
	"scripts": {
		"dev": "pnpm --filter @rojibura/city-host dev",
		"dev:free": "pnpm --filter @rojibura/city-host dev:free",
		"build": "pnpm --filter @rojibura/city-host build",
		"build:city": "node tools/city-build/src/build.ts assets/test-city/test_city.glb assets/test-city",
		"build:models": "node tools/city-build/src/model-cli.ts builtins",
		"test": "vitest run",
		"typecheck": "pnpm -r --no-bail typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"bench:nav": "node packages/nav/bench/bench.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
